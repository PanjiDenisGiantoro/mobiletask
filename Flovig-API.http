# Flovig / ProjectHub Pro API

###
# group: Auth
# @name Login
POST {{base_url}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password"
}

> {%
    // TODO: migrate to HTTP Client Response handler API
    // if (pm.response.code === 200) {
    //   const body = pm.response.json();
    //   if (body.token) pm.collectionVariables.set('token', body.token);
    // }
%}

###
# group: Auth
# @name Refresh session
POST {{base_url}}/auth/refresh
Authorization: Bearer {{token}}
Accept: application/json

###
# group: Auth
# @name Logout
POST {{base_url}}/auth/logout
Authorization: Bearer {{token}}
Accept: application/json

###
# group: Projects
# @name List projects
GET {{base_url}}/projects?
    page=1
Authorization: Bearer {{token}}

###
# group: Projects
# @name Get project detail
GET {{base_url}}/projects/{{project_id}}
Authorization: Bearer {{token}}

###
# group: Projects
# @name Create project
POST {{base_url}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Proyek Baru",
  "description": "",
  "client_id": null,
  "manager_id": null,
  "status": "active",
  "start_date": "2026-11-01",
  "end_date": "2026-12-31",
  "budget": 0,
  "budget_alert_threshold": 80,
  "github_repo_url": null
}

###
# group: Projects
# @name Update project
PUT {{base_url}}/projects/{{project_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Proyek Baru",
  "description": "",
  "client_id": null,
  "manager_id": null,
  "status": "active",
  "start_date": "2026-11-01",
  "end_date": "2026-12-31",
  "budget": 0,
  "budget_alert_threshold": 80,
  "github_repo_url": null
}

